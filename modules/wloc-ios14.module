#!url=https://raw.githubusercontent.com/Dlouxgit/wloc-ios14-shadowrocket/refs/heads/main/modules/wloc-ios14.module
#!name=Apple WLOC (iOS 14)
#!desc=Shadowrocket network-location response rewrite; compatible JavaScript syntax for iOS 14.0–14.4
#!author=Yu9191 Rewrite; iOS 14 compatibility build by Dlouxgit
#!homepage=https://github.com/Dlouxgit/wloc-ios14-shadowrocket
#!category=Tools

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/Dlouxgit/wloc-ios14-shadowrocket/refs/heads/main/dist/wloc.js,argument=logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/Dlouxgit/wloc-ios14-shadowrocket/refs/heads/main/dist/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com
